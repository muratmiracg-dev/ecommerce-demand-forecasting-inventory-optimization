{
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "dim_calendar",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "Month Key",
            "dataType": "string",
            "sourceColumn": "Month Key"
          }
        ],
        "partitions": [
          {
            "name": "dim_calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Date\", type date}, {\"Month\", type text}, {\"Month Key\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "monthly_performance",
        "columns": [
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "formatString": "mmm yyyy"
          },
          {
            "name": "Month Key",
            "dataType": "string",
            "sourceColumn": "Month Key"
          },
          {
            "name": "Estimated Demand",
            "dataType": "int64",
            "sourceColumn": "Estimated Demand",
            "formatString": "#,0"
          },
          {
            "name": "Units Sold",
            "dataType": "int64",
            "sourceColumn": "Units Sold",
            "formatString": "#,0"
          },
          {
            "name": "Fulfilled Demand",
            "dataType": "int64",
            "sourceColumn": "Fulfilled Demand",
            "formatString": "#,0"
          },
          {
            "name": "Lost Sales",
            "dataType": "int64",
            "sourceColumn": "Lost Sales",
            "formatString": "#,0"
          },
          {
            "name": "Stockout Events",
            "dataType": "int64",
            "sourceColumn": "Stockout Events",
            "formatString": "#,0"
          },
          {
            "name": "Average Inventory Value",
            "dataType": "double",
            "sourceColumn": "Average Inventory Value"
          },
          {
            "name": "Net Revenue",
            "dataType": "double",
            "sourceColumn": "Net Revenue"
          },
          {
            "name": "Gross Profit",
            "dataType": "double",
            "sourceColumn": "Gross Profit"
          },
          {
            "name": "Inventory Value",
            "dataType": "double",
            "sourceColumn": "Inventory Value"
          },
          {
            "name": "Weeks of Supply",
            "dataType": "double",
            "sourceColumn": "Weeks of Supply"
          },
          {
            "name": "Stockout SKU Weeks",
            "dataType": "int64",
            "sourceColumn": "Stockout SKU Weeks",
            "formatString": "#,0"
          },
          {
            "name": "Average Discount Rate",
            "dataType": "double",
            "sourceColumn": "Average Discount Rate"
          },
          {
            "name": "Demand Fulfillment Rate",
            "dataType": "double",
            "sourceColumn": "Demand Fulfillment Rate"
          },
          {
            "name": "Gross Margin Rate",
            "dataType": "double",
            "sourceColumn": "Gross Margin Rate"
          },
          {
            "name": "Service Level",
            "dataType": "double",
            "sourceColumn": "Service Level"
          },
          {
            "name": "Margin Attainment",
            "dataType": "double",
            "sourceColumn": "Margin Attainment"
          }
        ],
        "partitions": [
          {
            "name": "monthly_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Month\", type date}, {\"Month Key\", type text}, {\"Estimated Demand\", Int64.Type}, {\"Units Sold\", Int64.Type}, {\"Fulfilled Demand\", Int64.Type}, {\"Lost Sales\", Int64.Type}, {\"Stockout Events\", Int64.Type}, {\"Average Inventory Value\", type number}, {\"Net Revenue\", type number}, {\"Gross Profit\", type number}, {\"Inventory Value\", type number}, {\"Weeks of Supply\", type number}, {\"Stockout SKU Weeks\", Int64.Type}, {\"Average Discount Rate\", type number}, {\"Demand Fulfillment Rate\", type number}, {\"Gross Margin Rate\", type number}, {\"Service Level\", type number}, {\"Margin Attainment\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Historical Demand",
            "expression": "SUM(monthly_performance[Estimated Demand])",
            "formatString": "#,0"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(monthly_performance[Units Sold])",
            "formatString": "#,0"
          },
          {
            "name": "Fulfilled Demand",
            "expression": "SUM(monthly_performance[Fulfilled Demand])",
            "formatString": "#,0"
          },
          {
            "name": "Lost Sales",
            "expression": "SUM(monthly_performance[Lost Sales])",
            "formatString": "#,0"
          },
          {
            "name": "Stockout Events",
            "expression": "SUM(monthly_performance[Stockout Events])",
            "formatString": "#,0"
          },
          {
            "name": "Historical Revenue",
            "expression": "SUM(monthly_performance[Net Revenue])",
            "formatString": "₺#,0"
          },
          {
            "name": "Gross Profit",
            "expression": "SUM(monthly_performance[Gross Profit])",
            "formatString": "₺#,0"
          },
          {
            "name": "Inventory Value",
            "expression": "SUM(monthly_performance[Inventory Value])",
            "formatString": "₺#,0"
          },
          {
            "name": "Average Inventory Value",
            "expression": "AVERAGE(monthly_performance[Average Inventory Value])",
            "formatString": "₺#,0"
          },
          {
            "name": "Demand Fulfillment",
            "expression": "DIVIDE([Fulfilled Demand],[Historical Demand],0)",
            "formatString": "0.0%"
          },
          {
            "name": "Gross Margin",
            "expression": "DIVIDE([Gross Profit],[Historical Revenue],0)",
            "formatString": "0.0%"
          },
          {
            "name": "Service Level",
            "expression": "AVERAGE(monthly_performance[Service Level])",
            "formatString": "0.0%"
          },
          {
            "name": "Margin Attainment",
            "expression": "AVERAGE(monthly_performance[Margin Attainment])",
            "formatString": "0.0%"
          },
          {
            "name": "Weeks of Supply",
            "expression": "AVERAGE(monthly_performance[Weeks of Supply])",
            "formatString": "0.0"
          },
          {
            "name": "Stockout SKU Weeks",
            "expression": "SUM(monthly_performance[Stockout SKU Weeks])",
            "formatString": "#,0"
          },
          {
            "name": "Average Discount",
            "expression": "AVERAGE(monthly_performance[Average Discount Rate])",
            "formatString": "0.0%"
          },
          {
            "name": "Historical Demand PY",
            "expression": "CALCULATE([Historical Demand],DATEADD(dim_calendar[Date],-1,YEAR))",
            "formatString": "#,0"
          },
          {
            "name": "Historical Revenue PY",
            "expression": "CALCULATE([Historical Revenue],DATEADD(dim_calendar[Date],-1,YEAR))",
            "formatString": "₺#,0"
          },
          {
            "name": "Demand YoY %",
            "expression": "DIVIDE([Historical Demand]-[Historical Demand PY],[Historical Demand PY],0)",
            "formatString": "0.0%"
          },
          {
            "name": "Revenue YoY %",
            "expression": "DIVIDE([Historical Revenue]-[Historical Revenue PY],[Historical Revenue PY],0)",
            "formatString": "0.0%"
          },
          {
            "name": "Gross Profit Variance",
            "expression": "[Historical Revenue]-[Gross Profit]",
            "formatString": "₺#,0"
          },
          {
            "name": "Revenue vs GP Variance %",
            "expression": "DIVIDE([Gross Profit Variance],[Gross Profit],0)",
            "formatString": "0.0%"
          },
          {
            "name": "Service Level Target",
            "expression": "0.95",
            "formatString": "0.0%"
          },
          {
            "name": "Inventory Target",
            "expression": "[Gross Profit]*0.08",
            "formatString": "₺#,0"
          }
        ]
      },
      {
        "name": "sku_performance",
        "columns": [
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "formatString": "mmm yyyy"
          },
          {
            "name": "Month Key",
            "dataType": "string",
            "sourceColumn": "Month Key"
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product"
          },
          {
            "name": "Estimated Demand",
            "dataType": "int64",
            "sourceColumn": "Estimated Demand",
            "formatString": "#,0"
          },
          {
            "name": "Lost Sales",
            "dataType": "int64",
            "sourceColumn": "Lost Sales",
            "formatString": "#,0"
          },
          {
            "name": "Stockout Events",
            "dataType": "int64",
            "sourceColumn": "Stockout Events",
            "formatString": "#,0"
          },
          {
            "name": "Net Revenue",
            "dataType": "double",
            "sourceColumn": "Net Revenue"
          },
          {
            "name": "Gross Profit",
            "dataType": "double",
            "sourceColumn": "Gross Profit"
          },
          {
            "name": "Service Level",
            "dataType": "double",
            "sourceColumn": "Service Level"
          },
          {
            "name": "Weeks of Supply",
            "dataType": "double",
            "sourceColumn": "Weeks of Supply"
          }
        ],
        "partitions": [
          {
            "name": "sku_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Month\", type date}, {\"Month Key\", type text}, {\"Product\", type text}, {\"Estimated Demand\", Int64.Type}, {\"Lost Sales\", Int64.Type}, {\"Stockout Events\", Int64.Type}, {\"Net Revenue\", type number}, {\"Gross Profit\", type number}, {\"Service Level\", type number}, {\"Weeks of Supply\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "SKU Revenue",
            "expression": "SUM(sku_performance[Net Revenue])",
            "formatString": "₺#,0"
          },
          {
            "name": "SKU Gross Profit",
            "expression": "SUM(sku_performance[Gross Profit])",
            "formatString": "₺#,0"
          },
          {
            "name": "SKU Units Sold",
            "expression": "SUM(sku_performance[Estimated Demand])",
            "formatString": "#,0"
          },
          {
            "name": "SKU Lost Sales",
            "expression": "SUM(sku_performance[Lost Sales])",
            "formatString": "#,0"
          },
          {
            "name": "SKU Fulfillment Rate",
            "expression": "AVERAGE(sku_performance[Service Level])",
            "formatString": "0.0%"
          },
          {
            "name": "SKU Weeks of Supply",
            "expression": "AVERAGE(sku_performance[Weeks of Supply])",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "category_performance",
        "columns": [
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "formatString": "mmm yyyy"
          },
          {
            "name": "Month Key",
            "dataType": "string",
            "sourceColumn": "Month Key"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Estimated Demand",
            "dataType": "int64",
            "sourceColumn": "Estimated Demand",
            "formatString": "#,0"
          },
          {
            "name": "Fulfilled Demand",
            "dataType": "int64",
            "sourceColumn": "Fulfilled Demand",
            "formatString": "#,0"
          },
          {
            "name": "Demand Fulfillment Rate",
            "dataType": "double",
            "sourceColumn": "Demand Fulfillment Rate"
          },
          {
            "name": "Gross Profit",
            "dataType": "double",
            "sourceColumn": "Gross Profit"
          }
        ],
        "partitions": [
          {
            "name": "category_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Month\", type date}, {\"Month Key\", type text}, {\"Category\", type text}, {\"Estimated Demand\", Int64.Type}, {\"Fulfilled Demand\", Int64.Type}, {\"Demand Fulfillment Rate\", type number}, {\"Gross Profit\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Category Demand",
            "expression": "SUM(category_performance[Estimated Demand])",
            "formatString": "#,0"
          },
          {
            "name": "Category Units Sold",
            "expression": "SUM(category_performance[Fulfilled Demand])",
            "formatString": "#,0"
          },
          {
            "name": "Category Fulfillment",
            "expression": "DIVIDE([Category Units Sold],[Category Demand],0)",
            "formatString": "0.0%"
          },
          {
            "name": "Category Gross Profit",
            "expression": "SUM(category_performance[Gross Profit])",
            "formatString": "₺#,0"
          }
        ]
      },
      {
        "name": "Demand Stages",
        "columns": [
          {
            "name": "Stage",
            "dataType": "string",
            "sourceColumn": "Stage"
          },
          {
            "name": "Stage Order",
            "dataType": "int64",
            "sourceColumn": "Stage Order",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Demand Stages",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Binary = Binary.FromText(\"U3RhZ2UsU3RhZ2UgT3JkZXIKRXN0aW1hdGVkIERlbWFuZCwxCkZ1bGZpbGxlZCBEZW1hbmQsMgpMb3N0IFNhbGVzLDMKU3RvY2tvdXQgRXZlbnRzLDQK\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary, [Delimiter=\",\", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Stage\", type text}, {\"Stage Order\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Demand Stage Value",
            "expression": "SWITCH(SELECTEDVALUE('Demand Stages'[Stage]),\"Estimated Demand\",[Historical Demand],\"Fulfilled Demand\",[Fulfilled Demand],\"Lost Sales\",[Lost Sales],\"Stockout Events\",[Stockout Events],BLANK())",
            "formatString": "#,0"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_monthly_calendar",
        "fromTable": "monthly_performance",
        "fromColumn": "Month",
        "toTable": "dim_calendar",
        "toColumn": "Date"
      },
      {
        "name": "rel_sku_calendar",
        "fromTable": "sku_performance",
        "fromColumn": "Month",
        "toTable": "dim_calendar",
        "toColumn": "Date"
      },
      {
        "name": "rel_category_calendar",
